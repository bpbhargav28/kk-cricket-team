# ---------------------------------------------------------------------------
# KK Cricket Team — environment variables
#
# Copy this file to `.env` and fill in the two values from your Supabase
# project (Dashboard → Project Settings → API). `.env` is git-ignored.
#
#   cp .env.example .env
#
# SECURITY: every variable prefixed with VITE_ is inlined into the public
# JavaScript bundle. Only ever put the *publishable* (anon) key here.
# NEVER put the `service_role` key in this file, in any VITE_ variable, or
# anywhere else in this repository. It bypasses Row Level Security.
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# "anon" / "publishable" key — safe to expose, protected by RLS.
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Base path used by Vite. Defaults to /kk-cricket-team/ so the production
# build works at https://<user>.github.io/kk-cricket-team/.
# Set to "/" if you deploy to a custom domain or a <user>.github.io repo.
# VITE_BASE_PATH=/kk-cricket-team/

# Set to "true" to enable demo-data helpers. Only has any effect in a local
# dev build (`npm run dev`); it is ignored in production builds.
# VITE_ENABLE_DEMO_DATA=false

claude --resume 08123a8c-e301-4727-8f07-7f423d0ffbe3